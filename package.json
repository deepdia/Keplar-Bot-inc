### ৭. `src/bots/whatsappManager.js`
```javascript
const { Client, LocalAuth } = require('whatsapp-web.js');
const qrcode = require('qrcode');
const messageController = require('../controllers/messageController');

class WhatsappManager {
    constructor() {
        this.clients = {};
    }

    startBot(socket, choice, phone, userId) {
        if (this.clients[userId]) {
            socket.emit('bot_ready');
            return;
        }

        const client = new Client({
            authStrategy: new LocalAuth({ clientId: userId }), 
            puppeteer: {
                headless: true,
                args: ['--no-sandbox', '--disable-setuid-sandbox']
            },
            webVersionCache: { type: 'none' }
        });

        this.clients[userId] = client;

        client.on('qr', async (qr) => {
            if (choice === '1') {
                qrcode.toDataURL(qr, (err, url) => {
                    if (!err) socket.emit('qr_code', url);
                });
            } else if (choice === '2' && phone) {
                try {
                    const pairingCode = await client.requestPairingCode(phone);
                    socket.emit('pairing_code', pairingCode);
                } catch (err) {
                    console.error('Pairing Code Error:', err);
                }
            }
        });

        client.on('ready', () => {
            socket.emit('bot_ready');
            console.log(`✅ Enterprise Bot Live for User: ${userId}`);
        });

        client.on('message_create', async message => {
            await messageController.handle(message, userId, client); 
        });

        client.initialize();
    }

    async stopBot(socket, userId) {
        if (this.clients[userId]) {
            await this.clients[userId].destroy();
            delete this.clients[userId];
            console.log(`🛑 Bot Terminated for User: ${userId}`);
            if (socket) socket.emit('bot_stopped');
        }
    }
}

module.exports = new WhatsappManager();
```[cite: 3]

