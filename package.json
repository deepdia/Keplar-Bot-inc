### ৫. `src/handlers/antiSpamHandler.js`
```javascript
class AntiSpamHandler {
    constructor() {
        this.userSpamTracker = {};
    }

    async handle(message, chat, groupConfig, isAdmin, isBotAdmin, senderId) {
        if (!groupConfig.antispam || isAdmin) return false;

        const now = Date.now();
        if (!this.userSpamTracker[senderId]) this.userSpamTracker[senderId] = [];
        
        this.userSpamTracker[senderId].push(now);
        this.userSpamTracker[senderId] = this.userSpamTracker[senderId].filter(time => now - time < 5000);
        
        if (this.userSpamTracker[senderId].length > 4) { 
            if (isBotAdmin) {
                await message.delete(true);
                await chat.sendMessage(`🛑 @${senderId.split('@')[0]}, দয়া করে স্প্যামিং (Spamming) করা বন্ধ করুন!`, { mentions: [senderId] });
            }
            return true;
        }
        return false;
    }
}

module.exports = new AntiSpamHandler();
