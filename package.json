### ৪. `src/handlers/antiLinkHandler.js`
```javascript
class AntiLinkHandler {
    constructor() {
        this.userStrikes = {};
    }

    async handle(message, chat, groupConfig, isAdmin, isBotAdmin, senderId) {
        if (!groupConfig.antilink || isAdmin) return false;

        const linkRegex = /(https?:\/\/[^\s]+|www\.[^\s]+|wa\.me\S+|[a-zA-Z0-9-]+\.(com|in|net|org|link)\b)/gi;
        
        if (linkRegex.test(message.body)) {
            if (!isBotAdmin) {
                await message.reply('⚠️ আমাকে গ্রুপের অ্যাডমিন না করলে আমি লিংক ডিলিট বা মেম্বার রিমুভ করতে পারব না!');
                return true;
            }

            try {
                const groupId = chat.id._serialized;
                if (!this.userStrikes[groupId]) this.userStrikes[groupId] = {};
                if (!this.userStrikes[groupId][senderId]) this.userStrikes[groupId][senderId] = 0;
                
                this.userStrikes[groupId][senderId] += 1;
                const strikeCount = this.userStrikes[groupId][senderId];

                await message.delete(true); 
                
                if (strikeCount >= 3) {
                    await chat.removeParticipants([senderId]);
                    await chat.sendMessage(`🛑 @${senderId.split('@')[0]} কে গ্রুপ থেকে রিমুভ করা হয়েছে (৩ বার লিংক শেয়ার করার জন্য)!`, { mentions: [senderId] });
                    this.userStrikes[groupId][senderId] = 0; 
                } else {
                    await chat.sendMessage(`⚠️ @${senderId.split('@')[0]}, এই গ্রুপে লিংক শেয়ার করা নিষেধ!\n\n*সতর্কবার্তা:* ${strikeCount}/3\n(৩ বার লিংক দিলে আপনাকে গ্রুপ থেকে রিমুভ করা হবে!)`, { mentions: [senderId] });
                }
            } catch (error) {
                console.log("❌ Delete/Kick Error:", error);
            }
            return true;
        }
        return false;
    }
}

module.exports = new AntiLinkHandler();
